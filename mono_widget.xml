<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:padding="16dp" android:background="#EDE9E2">
    <TextView android:id="@+id/widget_month" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="NOV" android:textColor="#242424" android:textSize="34sp" android:textStyle="bold" android:letterSpacing="0.08" />
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="MONDAY · 23 NOVEMBER" android:textColor="#66615B" android:textSize="10sp" android:letterSpacing="0.12" />
    <TextView android:id="@+id/widget_clock" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="18:42" android:textColor="#242424" android:textSize="26sp" android:fontFamily="sans" />
</LinearLayout>
