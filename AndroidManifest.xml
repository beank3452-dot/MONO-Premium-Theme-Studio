<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.app_widgets" android:required="false" />
    <application
        android:allowBackup="true"
        android:label="MONO — Premium Theme Studio"
        android:theme="@style/Theme.MONO"
        android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".MonoMonthWidget" android:exported="true" android:label="MONO Month & Clock">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mono_widget_info" />
        </receiver>
    </application>
</manifest>
